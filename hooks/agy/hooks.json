{
  "eshu-agent-kit": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "h=../.agy/hooks/skill-nudge.sh; [ -x \"$h\" ] || exit 0; exec \"$h\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "h=../.agy/hooks/guard-live-gate.sh; [ -x \"$h\" ] || exit 0; exec \"$h\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "h=../.agy/hooks/pr-watch-guard.sh; [ -x \"$h\" ] || exit 0; exec \"$h\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "h=../.agy/hooks/skill-loaded.sh; [ -x \"$h\" ] || exit 0; exec \"$h\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "h=../.agy/hooks/pr-watch-nudge.sh; [ -x \"$h\" ] || exit 0; exec \"$h\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "h=../.agy/hooks/goal-continue.sh; [ -x \"$h\" ] || exit 0; exec \"$h\"",
        "timeout": 30
      }
    ]
  }
}
